# API Configuration
REACT_APP_API_SERVER=http://localhost:6001/api/

# LLM/OpenAI Configuration (optional - only needed for LLM features)
# Get your API key from https://platform.openai.com/api-keys
REACT_APP_LLM_API_KEY=your_openai_api_key_here
# Or use the alternative name:
# REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# LLM API URL (optional - defaults to OpenAI)
REACT_APP_LLM_API_URL=https://api.openai.com/v1/chat/completions

# LLM Model (optional - defaults to gpt-4o-mini)
REACT_APP_LLM_MODEL=gpt-4o-mini

# Public URL (optional - for PDF worker)
PUBLIC_URL=
